# Copy this file to .env and fill it in. NEVER commit .env.

# --- Meta / WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API Setup) ---
WHATSAPP_TOKEN=            # permanent System User token (see docs/02-whatsapp-bot.md)
WHATSAPP_PHONE_NUMBER_ID=  # "Phone number ID", not the phone number itself
WHATSAPP_VERIFY_TOKEN=pon-aqui-una-palabra-secreta
META_APP_SECRET=           # App settings > Basic > App secret
GRAPH_API_VERSION=v23.0

# Public https URL of this server (e.g. https://funnel-azul.up.railway.app)
PUBLIC_URL=

# Your personal WhatsApp (gets alerts + admin commands). Format 5939XXXXXXXX
OWNER_PHONE=

# --- Product ---
PRODUCT_NAME=El Cuaderno Azul
PRODUCT_DESCRIPTION=Tapa dura azul, minimalista y con cinta marcapáginas. Simple y hermoso 💙
# Leave empty to use assets/cuaderno-azul.jpg served by this server (needs PUBLIC_URL)
PRODUCT_IMAGE_URL=

# --- Volume pricing (upselling) ---
# min:price-per-notebook. 1 = $15 · 2+ = $13.50 c/u · 3+ = $12 c/u · 5+ = $11 c/u
PRICE_TIERS=1:15,2:13.5,3:12,5:11
FREE_SHIPPING_FROM=3
MAX_QTY=20

# --- Delivery LAAR ---
SHIPPING_COST=4.50
DELIVERY_DAYS=1 a 3 días hábiles

# --- Store pickup ---
STORE_ADDRESS=Av. Ejemplo N00-00 y Calle Ejemplo, Quito
STORE_MAPS_URL=https://maps.app.goo.gl/...
STORE_HOURS=Lunes a sábado, 10:00 a 19:00

# --- Payments ---
DEUNA_QR_URL=https://...tu-qr-deuna.png
DEUNA_PHONE=
BANK_NAME=Banco Pichincha
BANK_ACCOUNT_TYPE=Ahorros
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=
BANK_ACCOUNT_HOLDER_ID=
BANK_ACCOUNT_EMAIL=
